<?xml version="1.0" encoding="utf-8"?>
<!-- הדפדפן המובנה צריך לפתוח גם אתרים ישנים ב-http. Claude ועדכונים תמיד ב-https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
