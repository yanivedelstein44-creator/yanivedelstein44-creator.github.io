<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0E1420</color>
    <color name="accent">#4F8CFF</color>

    <style name="Theme.DuoPilot" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- מסכים שקופים שנסגרים מיד (קיצורי דרך, כניסה לעוזר הקולי) -->
    <style name="Theme.DuoPilot.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
