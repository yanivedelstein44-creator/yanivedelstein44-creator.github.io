<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- העוזר הקולי מדבר עם Claude, הדפדפן המובנה ובדיקת עדכונים -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- פקודות קוליות -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- השיחה עם DuoPilot באנדרואיד אוטו היא התראת הודעות (אנדרואיד 13+: אישור אחד) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- עדכון עצמי מהאתר, ובאנדרואיד 12+ בלי חלון אישור נוסף -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- בקשה (אופציונלית) לא להקפיא את האפליקציה בסמסונג -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- נראות אפליקציות (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.android.chrome" />
        <provider android:authorities="androidx.car.app.connection" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DuoPilot">

        <!-- אנדרואיד אוטו: DuoPilot מופיע שם כשיחת הודעות (מקריאים לך, ואתה עונה בקול) -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.yaniv.duopilot.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- כניסה לעוזר הקולי: אייקון "פקודה קולית", קיצור דרך, ו"עוזר דיגיטלי" (אם בוחרים בו בהגדרות) -->
        <activity
            android:name=".ui.VoiceEntryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/voice_launcher_label"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yaniv.duopilot.voice"
            android:theme="@style/Theme.DuoPilot.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.yaniv.duopilot.VOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".VoiceLauncher"
            android:exported="true"
            android:icon="@mipmap/ic_voice"
            android:label="@string/voice_launcher_label"
            android:roundIcon="@mipmap/ic_voice"
            android:targetActivity=".ui.VoiceEntryActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- קיצורי דרך במסך הבית שפותחים צמד -->
        <activity
            android:name=".ui.PairLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity="com.yaniv.duopilot.launch"
            android:theme="@style/Theme.DuoPilot.Invisible">
            <intent-filter>
                <action android:name="com.yaniv.duopilot.LAUNCH_PAIR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- שני דפדפנים מובנים (כל אחד במשימה משלו, כדי שאפשר יהיה לשים את שניהם במסך מפוצל) -->
        <activity
            android:name=".browser.BrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:label="@string/browser_label"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="com.yaniv.duopilot.browser"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".browser.BrowserActivityB"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:label="@string/browser_label_b"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="com.yaniv.duopilot.browser2"
            android:windowSoftInputMode="adjustResize" />

        <!-- הלב: שירות נגישות שפותח מסך מפוצל, זוכר גלילה ולוחץ בשביל העוזר הקולי -->
        <service
            android:name=".service.PilotService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <receiver
            android:name=".car.CarReplyReceiver"
            android:exported="false" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".update.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
