# כתובת האתר הציבורי שבו מתפרסם dist (GitHub Pages / Netlify). חובה לעדכוני APK ולקישורי הזמנה מהאפליקציה.
VITE_PUBLIC_URL=https://YOUR-USER.github.io/chess-of-ages/
# (לא חובה) מאיפה לבדוק עדכונים — ברירת מחדל: VITE_PUBLIC_URL
VITE_UPDATE_URL=
# (לא חובה) קישור להורדת APK חדש כשנדרש עדכון "מקומי" מלא
VITE_APK_URL=https://github.com/YOUR-USER/chess-of-ages/releases/latest/download/chess-of-ages.apk

# (לא חובה) שרת PeerJS משלכם במקום שרת הענן הציבורי — מומלץ לפרודקשן
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
VITE_PEER_KEY=
# (לא חובה) שרתי STUN/TURN משלכם, כ-JSON
# VITE_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
