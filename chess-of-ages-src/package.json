{
  "name": "chess-of-ages",
  "private": true,
  "version": "1.3.8",
  "type": "module",
  "description": "שחמט העידנים: ממלכות האיים — Chess of Ages: Island Realms (PWA + Capacitor)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "release": "npm version patch --no-git-tag-version && vite build",
    "test:engine": "node scripts/test-engine.mjs",
    "cap:add": "npx cap add android",
    "cap:sync": "vite build && npx cap sync android",
    "cap:open": "npx cap open android",
    "publish:site": "bash scripts/publish-site.sh"
  },
  "palace": {
    "minNativeVersion": "1.1.1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capgo/capacitor-updater": "^8.54.2",
    "@fontsource/rubik": "^5.3.0",
    "chess.js": "^1.4.0",
    "firebase": "^13.2.0",
    "gsap": "^3.15.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "fflate": "^0.8.3",
    "vite": "^8.3.6"
  }
}
