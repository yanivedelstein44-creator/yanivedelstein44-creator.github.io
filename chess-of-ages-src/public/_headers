# Netlify headers — עדכונים מהירים + CORS לבדיקת גרסה מאפליקציית ה-APK
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Access-Control-Allow-Origin: *
/index.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/manifest.he.json
  Cache-Control: no-cache
/privacy.html
  Cache-Control: no-cache
/update/*
  Access-Control-Allow-Origin: *
/assets/*
  Cache-Control: public, max-age=31536000, immutable
